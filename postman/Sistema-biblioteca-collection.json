							"mode": "raw",
							"raw": "{\n  \"titulo\": \"Java para Iniciantes\",\n  \"isbn\": \"9781234567890\",\n  \"ano\": 2026,\n  \"quantidade\": 5,\n  \"categoriaId\": 1,\n  \"autorIds\": [1]\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/livros", "host": ["{{baseUrl}}"], "path": ["api", "livros"] }
					}
				},
				{
					"name": "Listar Livros",
