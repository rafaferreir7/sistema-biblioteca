							"mode": "raw",
							"raw": "{\n  \"titulo\": \"Java Avançado\",\n  \"isbn\": \"9781234567890\",\n  \"ano\": 2026,\n  \"quantidade\": 3,\n  \"categoriaId\": 1,\n  \"autorIds\": [1]\n}"
