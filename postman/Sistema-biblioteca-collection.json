{
	"info": {
		"name": "Sistema Biblioteca - API",
		"description": "Collection com todas as rotas do back-end (Leitor, Livro, Autor, Categoria, Multa, Reserva, Empréstimo, Biblioteca, Bibliotecário, Pessoa)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Leitor",
			"item": [
				{
					"name": "Cadastrar Leitor",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"nome\": \"Maria Teste\",\n  \"cpf\": \"98765432100\",\n  \"email\": \"maria@teste.com\",\n  \"telefone\": \"87999999999\",\n  \"ativo\": true\n}"
						},
						"url": { "raw": "{{baseUrl}}/leitores", "host": ["{{baseUrl}}"], "path": ["leitores"] }
					}
				},
				{
					"name": "Listar Leitores",
					"request": {
						"method": "GET",
						"url": { "raw": "{{baseUrl}}/leitores", "host": ["{{baseUrl}}"], "path": ["leitores"] }
					}
				},
				{
					"name": "Buscar Leitor por ID",
					"request": {
						"method": "GET",
						"url": { "raw": "{{baseUrl}}/leitores/1", "host": ["{{baseUrl}}"], "path": ["leitores", "1"] }
					}
				}
			]
		},
